# Database configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=root
DB_NAME=profitnessgym

# Application environment: production | local
APP_ENV=local

# Random secret key for HMAC and session security
APP_KEY=

# Storage path OUTSIDE the document root (uploaded files, logs).
# Relative paths resolve against the project root.
STORAGE_PATH=../gms-storage

# Cloudflare Turnstile (empty = verification skipped, local dev)
TURNSTILE_SECRET=
TURNSTILE_SITEKEY=

# Public base URL for signed client links (empty = auto-detect from request)
APP_URL=
